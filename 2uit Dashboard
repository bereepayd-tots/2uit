}

function StatusPill({ status }) {
  const icon = status === "passed" ? <CheckCircle2 size={12} /> : status === "failed" ? <XCircle size={12} /> : <Loader2 size={12} className={status === "running" ? "animate-spin" : ""} />;
  return (
    <span
      className="flex items-center gap-1 px-2 py-0.5 rounded shrink-0"
      style={{ fontFamily: monoFont, fontSize: 10.5, color: statusDot[status] || c.inkMuted, border: `1px solid ${statusDot[status] || c.border}55` }}
    >
      {icon} {status}
    </span>
  );
}

