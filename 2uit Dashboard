function ProgressView() {
  const passedTests = testRuns.filter((t) => t.status === "passed").length;
  const testPct = testRuns.length ? passedTests / testRuns.length : 0;

  const resolvedExp = experiments.filter((e) => e.status !== "running").length;
  const expPct = experiments.length ? resolvedExp / experiments.length : 0;

  const activeContracts = contracts.filter((k) => k.status === "active").length;
  const contractPct = contracts.length ? activeContracts / contracts.length : 0;

  const stableDeps = dependencies.filter((d) => d.status === "stable").length;
  const depPct = dependencies.length ? stableDeps / dependencies.length : 0;

  const metrics = [
    { label: "Test pass rate", value: `${passedTests}/${testRuns.length}`, pct: testPct, color: c.teal, icon: ClipboardCheck },
    { label: "Experiments resolved", value: `${resolvedExp}/${experiments.length}`, pct: expPct, color: c.copper, icon: FlaskConical },
    { label: "Contracts active", value: `${activeContracts}/${contracts.length}`, pct: contractPct, color: c.teal, icon: Briefcase },
    { label: "Dependencies stable", value: `${stableDeps}/${dependencies.length}`, pct: depPct, color: c.copper, icon: GitBranch },
  ];

  return (
    <div className="px-4 pb-2">
      <SectionHeading title="Progress" subtitle="Your analytics across tests, experiments, and contracts" />
      <div className="grid grid-cols-2 gap-3 mb-3">
        {metrics.map((m) => (
          <div
            key={m.label}
            className="relative flex flex-col items-center text-center px-3 py-4"
            style={{ background: c.bgPanel, border: `1px solid ${c.border}`, borderRadius: 4 }}
          >
            <ProgressRing size={54} pct={m.pct} color={m.color} icon={m.icon} iconSize={20} />
            <div style={{ fontFamily: monoFont, color: c.ink, fontSize: 13.5, fontWeight: 600, marginTop: 10 }}>{m.value}</div>
            <div style={{ fontFamily: bodyFont, color: c.inkFaint, fontSize: 10.5, marginTop: 2 }}>{m.label}</div>
          </div>
        ))}
      </div>
      <Panel>
        <div className="flex items-center gap-3">
          <ProgressRing size={40} pct={(testPct + expPct + contractPct + depPct) / 4} color={c.copper} icon={TrendingUp} iconSize={17} />
          <div>
            <div style={{ fontFamily: bodyFont, color: c.ink, fontSize: 12.5, fontWeight: 600 }}>Overall momentum</div>
            <div style={{ fontFamily: bodyFont, color: c.inkFaint, fontSize: 11 }}>Blended across tests, experiments, contracts, and dependencies</div>
          </div>
        </div>
      </Panel>
    </div>
  );
}

