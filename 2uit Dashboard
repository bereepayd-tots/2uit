export default function TwoUitDashboard() {
  const [activeSection, setActiveSection] = useState({ row: "secondary", id: "feed" });
  const [primary, setPrimary] = useState("home");
  const [secondary, setSecondary] = useState("feed");
  const [bottom, setBottom] = useState(null);

  const [posts, setPosts] = useState(initialPosts);
  const [menuOpenId, setMenuOpenId] = useState(null);
  const [showSearch, setShowSearch] = useState(false);
  const [query, setQuery] = useState("");
  const [showMenu, setShowMenu] = useState(false);
  const [showCompose, setShowCompose] = useState(false);
  const [notifs, setNotifs] = useState(notifications);
  const [principles, setPrinciples] = useState(initialPrinciples);
  const [dmOpenId, setDmOpenId] = useState(null);
  const [dmThreads, setDmThreads] = useState(initialDmThreads);

  const goPrimary = (id) => {
    setPrimary(id);
    setBottom(null);
    if (id === "home") { setSecondary("feed"); setActiveSection({ row: "secondary", id: "feed" }); }
    else setActiveSection({ row: "primary", id });
  };
  const goSecondary = (id) => {
    setSecondary(id);
    setPrimary("home");
    setBottom(null);
    setActiveSection({ row: "secondary", id });
  };
  const goBottom = (id) => {
    setBottom(id);
    setActiveSection({ row: "bottom", id });
  };

  const markRead = (id) => setNotifs((ns) => ns.map((n) => (n.id === id ? { ...n, unread: false } : n)));
  const openMessageFromNotification = (n) => {
    markRead(n.id);
    setDmOpenId(n.dmId);
    goBottom("message");
  };
  const togglePrinciple = (id) => setPrinciples((ps) => ps.map((p) => (p.id === id ? { ...p, enabled: !p.enabled } : p)));
  const publishPost = (title, body) => {
    setPosts((ps) => [
      { id: Date.now(), initials: "YOU", name: "You", role: "Full-stack Engineer", status: "online", time: "now", title, body: body || "No description provided.", tags: ["new"], intents: 0, comments: 0, likes: 0 },
      ...ps,
    ]);
    setShowCompose(false);
    setPrimary("home"); setSecondary("feed"); setActiveSection({ row: "secondary", id: "feed" }); setBottom(null);
  };

  const filteredPosts = query.trim()
    ? posts.filter((p) => (p.title + p.body).toLowerCase().includes(query.toLowerCase()))
    : posts;

  const renderContent = () => {
    if (activeSection.row === "primary") {
      switch (activeSection.id) {
        case "test": return <TestView />;
        case "colleagues": return <ColleaguesView />;
        case "progress": return <ProgressView />;
        case "notifications": return <NotificationsView notifs={notifs} onRead={markRead} onOpenMessage={openMessageFromNotification} />;
        case "profile": return <ProfileView />;
        default: return <FeedView posts={filteredPosts} menuOpenId={menuOpenId} setMenuOpenId={setMenuOpenId} />;
      }
    }
    if (activeSection.row === "bottom") {
      switch (activeSection.id) {
        case "threads": return <ThreadsView />;
        case "message": return <MessageView openId={dmOpenId} setOpenId={setDmOpenId} threads={dmThreads} setThreads={setDmThreads} />;
        case "interface": return <InterfaceView />;
        case "evidence": return <EvidenceView />;
        case "principles": return <PrinciplesView principles={principles} onToggle={togglePrinciple} />;
        default: return null;
      }
    }
    switch (activeSection.id) {
      case "explore": return <ExploreView />;
      case "dependencies": return <DependenciesView />;
      case "contracts": return <ContractsView />;
      case "experiments": return <ExperimentsView />;
      default: return <FeedView posts={filteredPosts} menuOpenId={menuOpenId} setMenuOpenId={setMenuOpenId} />;
    }
  };

  const unreadCount = notifs.filter((n) => n.unread).length;

  return (
    <div className="min-h-screen flex justify-center" style={{ background: "#081E30" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');
      `}</style>

      <div
        className="relative w-full flex flex-col"
        style={{
          maxWidth: 430, minHeight: "100vh", background: c.bgDeep,
          backgroundImage: `linear-gradient(${c.grid} 1px, transparent 1px), linear-gradient(90deg, ${c.grid} 1px, transparent 1px)`,
          backgroundSize: "22px 22px",
          borderLeft: `1px solid ${c.border}`, borderRight: `1px solid ${c.border}`,
        }}
        onClick={() => { if (menuOpenId !== null) setMenuOpenId(null); if (showMenu) setShowMenu(false); }}
      >
        {/* top bar */}
        <div className="flex items-center justify-between px-4 pt-5 pb-3" style={{ borderBottom: `1px solid ${c.gridStrong}` }}>
          <div className="flex items-center gap-2">
            <button
              onClick={(e) => { e.stopPropagation(); setShowCompose(true); }}
              className="flex items-center justify-center rounded"
              style={{ width: 26, height: 26, border: `1px solid ${c.copper}` }}
              aria-label="Post a blueprint"
            >
              <Plus size={14} style={{ color: c.copper }} />
            </button>
            <span style={{ fontFamily: displayFont, color: c.ink, fontSize: 20, fontWeight: 700, letterSpacing: 0.3 }}>2uit</span>
          </div>
          <div className="flex items-center gap-4 relative">
            <button onClick={(e) => { e.stopPropagation(); setShowSearch((s) => !s); }} aria-label="Search">
              <Search size={18} style={{ color: showSearch ? c.copper : c.inkMuted }} />
            </button>
            <button
              onClick={(e) => { e.stopPropagation(); goPrimary("notifications"); }}
              className="relative"
              aria-label="Notifications"
            >
              <Bell size={18} style={{ color: c.inkMuted }} />
              {unreadCount > 0 && (
                <span className="absolute -top-1 -right-1 flex items-center justify-center rounded-full" style={{ width: 13, height: 13, background: c.copper, fontFamily: monoFont, fontSize: 8.5, color: c.bgDeep }}>{unreadCount}</span>
              )}
            </button>
            <button onClick={(e) => { e.stopPropagation(); setShowMenu((m) => !m); }} aria-label="Menu">
              <MenuIcon size={18} style={{ color: showMenu ? c.copper : c.inkMuted }} />
            </button>
            {showMenu && (
              <div className="absolute right-0 top-7 z-20 py-1" style={{ background: c.bgPanelRaised, border: `1px solid ${c.border}`, borderRadius: 4, width: 150 }}>
                {[{ label: "Settings", icon: Settings }, { label: "Help", icon: HelpCircle }, { label: "Log out", icon: LogOut }].map((opt) => (
                  <button key={opt.label} onClick={() => setShowMenu(false)} className="flex items-center gap-2 w-full px-3 py-1.5 text-left" style={{ fontFamily: bodyFont, fontSize: 12, color: c.inkMuted }}>
                    <opt.icon size={13} /> {opt.label}
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>

        {showSearch && (
          <div className="px-4 pt-3">
            <input
              autoFocus
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search the feed..."
              className="w-full px-3 py-2 outline-none"
              style={{ fontFamily: bodyFont, fontSize: 13, color: c.ink, background: c.bgPanel, border: `1px solid ${c.border}`, borderRadius: 4 }}
            />
          </div>
        )}

        {/* primary tabs */}
        <div className="flex items-center justify-between px-3 pt-2 pb-2" style={{ borderBottom: `1px solid ${c.gridStrong}` }}>
          {primaryTabs.map((t) => {
            const Icon = t.icon;
            const active = primary === t.id && activeSection.row !== "bottom" && (t.id !== "home" || activeSection.row === "secondary");
            return (
              <button key={t.id} onClick={() => goPrimary(t.id)} className="flex flex-col items-center gap-1 px-1.5 py-1">
                <Icon size={17} style={{ color: active ? c.copper : c.inkFaint }} />
                <span style={{ fontFamily: monoFont, fontSize: 9.5, color: active ? c.copper : c.inkFaint }}>{t.label}</span>
                {active && <span style={{ width: 14, height: 2, background: c.copper, borderRadius: 1, marginTop: 1 }} />}
              </button>
            );
          })}
        </div>

        {/* secondary pill tabs */}
        <div className="flex items-center gap-2 px-4 py-3 overflow-x-auto" style={{ scrollbarWidth: "none" }}>
          {secondaryTabs.map((t) => {
            const Icon = t.icon;
            const active = activeSection.row === "secondary" && secondary === t.id;
            return (
              <button
                key={t.id}
                onClick={() => goSecondary(t.id)}
                className="flex items-center gap-1.5 px-3 py-1.5 shrink-0"
                style={{ fontFamily: monoFont, fontSize: 11.5, borderRadius: 999, border: `1px solid ${active ? c.copper : c.border}`, background: active ? c.copperSoft : "transparent", color: active ? c.copper : c.inkMuted, whiteSpace: "nowrap" }}
              >
                <Icon size={13} /> {t.label}
              </button>
            );
          })}
        </div>

        {/* content */}
        <div className="flex-1 pb-24 overflow-y-auto">{renderContent()}</div>

        {/* compose FAB */}
        <button
          onClick={() => setShowCompose(true)}
          className="absolute flex items-center justify-center rounded-full"
          style={{ width: 48, height: 48, right: 18, bottom: 76, background: c.copper, boxShadow: "0 4px 14px rgba(206,132,82,0.4)" }}
          aria-label="Post a blueprint"
        >
          <Plus size={22} style={{ color: c.bgDeep }} />
        </button>

        {/* bottom nav */}
        <div className="absolute bottom-0 left-0 right-0 flex items-center justify-between px-3 py-2.5" style={{ background: c.bgPanelRaised, borderTop: `1px solid ${c.gridStrong}` }}>
          {bottomTabs.map((t) => {
            const Icon = t.icon;
            const active = bottom === t.id;
            return (
              <button key={t.id} onClick={() => goBottom(t.id)} className="flex flex-col items-center gap-1 px-1">
                <Icon size={17} style={{ color: active ? c.teal : c.inkFaint }} />
                <span style={{ fontFamily: monoFont, fontSize: 9, color: active ? c.teal : c.inkFaint }}>{t.label}</span>
              </button>
            );
          })}
        </div>

        {showCompose && <ComposeModal onClose={() => setShowCompose(false)} onPublish={publishPost} />}
      </div>
    </div>
  );
}
