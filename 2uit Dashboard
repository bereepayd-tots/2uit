        </div>
        <div className="flex items-center gap-2 relative">
          <button onClick={() => setSaved((s) => !s)} aria-label="Save post">
            <Star size={16} style={{ color: saved ? c.copper : c.inkFaint, fill: saved ? c.copper : "none" }} />
