function MessageView({ openId, setOpenId, threads, setThreads }) {
  const [draft, setDraft] = useState("");

  const openDm = dms.find((d) => d.id === openId);

  const sendReply = () => {
    if (!draft.trim() || !openId) return;
    setThreads((t) => ({
      ...t,
      [openId]: [...(t[openId] || []), { id: Date.now(), from: "me", text: draft.trim(), time: "now" }],
    }));
    setDraft("");
  };

  if (openDm) {
    const msgs = threads[openId] || [];
    return (
      <div className="px-4 pb-2 flex flex-col" style={{ minHeight: "60vh" }}>
        <button onClick={() => setOpenId(null)} className="flex items-center gap-1 mb-3" style={{ fontFamily: monoFont, fontSize: 11, color: c.inkMuted }}>
          <ChevronLeft size={14} /> Messages
        </button>
        <div className="flex items-center gap-2 mb-4">
          <div className="flex items-center justify-center rounded-full shrink-0" style={{ width: 32, height: 32, background: c.copperSoft, border: `1px solid ${c.copper}`, fontFamily: monoFont, color: c.copper, fontSize: 11 }}>
            {openDm.initials}
          </div>
          <div style={{ fontFamily: bodyFont, color: c.ink, fontSize: 13, fontWeight: 600 }}>{openDm.name}</div>
        </div>

        <div className="flex-1 flex flex-col gap-2 mb-4">
          {msgs.map((m) => (
            <div key={m.id} className={`flex ${m.from === "me" ? "justify-end" : "justify-start"}`}>
              <div
                className="px-3 py-2"
                style={{
                  maxWidth: "78%",
                  fontFamily: bodyFont, fontSize: 12.5, lineHeight: 1.45,
                  color: m.from === "me" ? c.bgDeep : c.ink,
                  background: m.from === "me" ? c.copper : c.bgPanel,
                  border: m.from === "me" ? "none" : `1px solid ${c.border}`,
                  borderRadius: 12,
                  borderBottomRightRadius: m.from === "me" ? 3 : 12,
                  borderBottomLeftRadius: m.from === "me" ? 12 : 3,
                }}
              >
                {m.text}
              </div>
            </div>
          ))}
        </div>

        <div className="flex items-center gap-2">
          <input
            value={draft}
            onChange={(e) => setDraft(e.target.value)}
            onKeyDown={(e) => { if (e.key === "Enter") sendReply(); }}
            placeholder="Write a reply..."
            className="flex-1 px-3 py-2 outline-none"
            style={{ fontFamily: bodyFont, fontSize: 12.5, color: c.ink, background: c.bgPanel, border: `1px solid ${c.border}`, borderRadius: 20 }}
          />
          <button
            onClick={sendReply}
            className="flex items-center justify-center rounded-full shrink-0"
            style={{ width: 34, height: 34, background: draft.trim() ? c.copper : c.bgPanelRaised, border: `1px solid ${draft.trim() ? c.copper : c.border}` }}
            aria-label="Send reply"
          >
            <Send size={14} style={{ color: draft.trim() ? c.bgDeep : c.inkFaint }} />
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="px-4 pb-2">
      <SectionHeading title="Messages" subtitle="Direct messages with colleagues" />
      {dms.map((m) => {
        const msgs = threads[m.id] || [];
        const last = msgs[msgs.length - 1];
        return (
          <button key={m.id} onClick={() => setOpenId(m.id)} className="w-full text-left">
            <Panel>
              <div className="flex items-center gap-3">
                <div className="flex items-center justify-center rounded-full shrink-0" style={{ width: 32, height: 32, background: c.copperSoft, border: `1px solid ${c.copper}`, fontFamily: monoFont, color: c.copper, fontSize: 11 }}>
                  {m.initials}
                </div>
                <div className="min-w-0 flex-1">
                  <div style={{ fontFamily: bodyFont, color: c.ink, fontSize: 13, fontWeight: 600 }} className="truncate">{m.name}</div>
                  <div style={{ fontFamily: bodyFont, color: c.inkFaint, fontSize: 11.5 }} className="truncate">
                    {last ? (last.from === "me" ? "You: " : "") + last.text : m.lastMessage}
                  </div>
                </div>
                {m.unread && <span className="shrink-0 rounded-full" style={{ width: 6, height: 6, background: c.copper }} />}
              </div>
            </Panel>
          </button>
        );
      })}
    </div>
  );
}

